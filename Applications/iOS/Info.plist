<?xml version="1.0" encoding="UTF-8"?>
<!--
  Endurance — iOS app Info.plist.
  Local notifications need no Info.plist key (permission is requested at runtime).
  HealthKit / Location / WeatherKit purpose strings are added in later releases
  when those capabilities ship (see CAPABILITIES.md), each with a specific,
  user-facing reason string.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard bundle keys. Required because this target uses an explicit
         INFOPLIST_FILE rather than GENERATE_INFOPLIST_FILE, so nothing injects
         them for us — without CFBundleIdentifier the Simulator refuses to
         install the .app ("Missing bundle ID"). Values come from build settings
         so the product name stays isolated in project.yml. -->
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Endurance</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <!-- Modern launch: a plain, quick launch screen (no prolonged splash). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Custom URL scheme used for deep links from notification taps. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.example.endurance.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>endurance</string>
            </array>
        </dict>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- HealthKit purpose strings (§C). These are shown verbatim in the system
         permission sheet, so they name what is read, what is written, and that
         the plan works without granting anything. Vague copy here is both an App
         Review risk and a genuine failure to inform. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Endurance can read your completed workouts, heart rate, distance, and active energy so finished sessions appear against your training plan automatically. Your training plan works fully without this, and nothing leaves your device.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Endurance can save workouts you log here to Health, so your training appears alongside everything else you record. This is optional, off by default, and Endurance never edits workouts created by other apps.</string>
</dict>
</plist>
